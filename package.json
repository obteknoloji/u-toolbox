{
  "name": "u-toolbox",
  "productName": "Ü Toolbox",
  "version": "0.0.4",
  "description": "An advanced system optimization and performance toolkit for Windows 11.",
  "author": "obteknoloji",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "vite --port 5133 --strictPort",
    "build": "vite build --base=./ --outDir out",
    "preview": "vite preview",
    "electron:start": "cross-env ELECTRON_RUN_AS_NODE= NODE_ENV=development electron .",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on tcp:5133 && npm run electron:start\"",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.windows.u-toolbox",
    "productName": "Ü Toolbox",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "obteknoloji",
        "repo": "u-toolbox"
      }
    ],
    "win": {
      "requestedExecutionLevel": "requireAdministrator",
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerLanguages": [
        "en_US",
        "tr_TR"
      ],
      "displayLanguageSelector": true,
      "multiLanguageInstaller": true,
      "shortcutName": "Ü Toolbox",
      "artifactName": "u-toolbox-setup-${version}.${ext}",
      "uninstallDisplayName": "Ü Toolbox",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "out/**/*",
      "main.js",
      "preload.cjs",
      "package.json"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "vite": "^8.0.1",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.0",
    "electron-updater": "^6.8.3",
    "koffi": "^3.0.2",
    "systeminformation": "^5.31.5"
  }
}
